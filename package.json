{
  "name": "surf",
  "version": "0.1.0",
  "type": "module",
  "description": "Launch and supervise Chromium browser sessions, app windows, and performance traces",
  "funding": "https://github.com/sponsors/Jaid",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jaid/surf.git"
  },
  "exports": {
    ".": {
      "default": "./src/index.ts"
    }
  },
  "bin": {
    "surf": "./src/main.ts"
  },
  "imports": {
    "#src/*": "./src/*",
    "#root/*": "./*"
  },
  "scripts": {
    "lint": "eslint .",
    "start": "bun src/main.ts",
    "test": "bun test --max-concurrency 1 ./test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cheerio": "1.2.0",
    "forward-slash-path": "0.3.0",
    "fs-extra": "11.4.1",
    "msgpackr": "2.1.2",
    "puppeteer-core": "25.16.0",
    "sharp": "0.35.5",
    "sharp-ico": "0.1.5",
    "@clerc/core": "1.3.1",
    "@clerc/plugin-friendly-error": "1.3.1",
    "@clerc/plugin-help": "1.3.1",
    "@clerc/plugin-strict-flags": "1.3.1",
    "@clerc/plugin-version": "1.3.1"
  },
  "devDependencies": {
    "eslint": "10.13.0",
    "eslint-config-jaid": "37.1.0",
    "tsconfig-jaid-bun": "16.0.0",
    "typescript": "npm:typescript-classic@6.0.4",
    "@types/bun": "1.4.3",
    "@types/fs-extra": "11.0.4"
  }
}
